[Unit]
Description=Kanlo physical-console setup (Ctrl+Alt+F2)
After=kanlo-firstboot.service NetworkManager.service
Conflicts=getty@tty2.service

[Service]
Type=simple
Environment=TERM=linux
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 /usr/lib/kanlo/appliance.py setup
Restart=always
RestartSec=2
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty2
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
