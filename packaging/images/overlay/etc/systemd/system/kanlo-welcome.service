[Unit]
Description=Kanlo first-run keyboard and Wi-Fi settings
After=kanlo-firstboot.service NetworkManager.service
Wants=NetworkManager.service
Before=kanlo-tv.service

[Service]
Type=oneshot
ExecCondition=/usr/bin/python3 /usr/lib/kanlo/appliance.py needs-welcome
ExecStart=/usr/bin/python3 /usr/lib/kanlo/appliance.py welcome
TimeoutStartSec=infinity
StandardInput=tty
StandardOutput=tty
StandardError=tty
Environment=TERM=linux
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
