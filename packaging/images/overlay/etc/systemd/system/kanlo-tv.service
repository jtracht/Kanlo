[Unit]
Description=Kanlo native appliance display
After=kanlo-firstboot.service kanlo-server.service seatd.service getty@tty1.service
Wants=kanlo-server.service seatd.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
User=kanlo-display
SupplementaryGroups=video render
ExecCondition=/usr/bin/python3 /usr/lib/kanlo/appliance.py has-display
ExecStartPre=-+/usr/bin/chvt 1
RuntimeDirectory=kanlo-display
RuntimeDirectoryMode=0700
StateDirectory=kanlo-display
StateDirectoryMode=0700
Environment=XDG_RUNTIME_DIR=/run/kanlo-display
Environment=LIBSEAT_BACKEND=seatd
Environment=SDL_VIDEODRIVER=wayland
Environment=SDL_VIDEO_WAYLAND_ALLOW_LIBDECOR=0
Environment=XDG_CACHE_HOME=/run/kanlo-display/cache
Environment=WLR_RENDERER=pixman
Environment=LP_NUM_THREADS=2
ExecStart=/usr/bin/python3 /usr/lib/kanlo/display.py --launch
Restart=always
RestartSec=5
TimeoutStartSec=25
StandardInput=tty-fail
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
