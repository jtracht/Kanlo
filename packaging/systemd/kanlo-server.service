[Unit]
Description=Kanlo local development server
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=kanlo
Group=kanlo
StateDirectory=kanlo
StateDirectoryMode=0700
Environment=KANLO_DATA_DIR=/var/lib/kanlo
Environment=KANLO_BIND=127.0.0.1:8080
ExecStart=/usr/local/lib/kanlo/kanlo-server
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target

